# Copy to .env and fill in real values. Never commit .env.

# CRE signing key — funded Sepolia wallet, 64-char hex, no 0x prefix
CRE_ETH_PRIVATE_KEY=

# Chainlink Data Streams API credentials from https://data.chain.link
# Set both to "stub" to run simulation without real credentials
DS_CLIENT_ID_VAR=stub
DS_CLIENT_SECRET_VAR=stub
